<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Website tracking & blocking. Sideload-only: Accessibility use outside accessibility
             tools is a Play-policy risk, and Android 17 Advanced Protection Mode revokes it
             (brainstorm §2.1), so app blocking never depends on it. -->
        <service
            android:name="com.xern.xrnhabit.app.web.BrowserAccessibilityService"
            android:exported="true"
            android:label="@string/web_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/browser_accessibility" />
        </service>
    </application>
</manifest>
